# 4N DEV Core V2 — production environment template
# Copy this file to /etc/4n-dev-core/core.env on the VPS.
# NEVER commit the real production file or real secrets.

NODE_ENV=production
PORT=10000

# VPS-local PostgreSQL
DATABASE_URL=postgresql://4n_dev_core:REPLACE_DB_PASSWORD@127.0.0.1:5432/4n_dev_core
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Public domains: Core API and Developer Console are separate origins.
CORE_DOMAIN=core.4ndev.com
CORS_ORIGIN=https://console.4ndev.com

# Generate unique random values on the VPS.
API_KEY_PEPPER=REPLACE_WITH_RANDOM_SECRET
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET

# AI provider
# Keep "none" until the real provider credential and pricing are configured.
AI_PROVIDER=none
OPENAI_API_KEY=

PROVIDER_CHAT_MODEL=gpt-5.6-luna
PROVIDER_CODING_MODEL=gpt-5.6-sol
PROVIDER_IMAGE_MODEL=gpt-image-2.5-flare
PROVIDER_BUILDER_MODEL=gpt-5.6-sol

# Zopayo
ZOPAYO_API_KEY=REPLACE_WITH_ZOPAYO_PRIVATE_KEY
ZOPAYO_WEBHOOK_SECRET=REPLACE_WITH_ZOPAYO_WEBHOOK_SECRET
ZOPAYO_SUCCESS_URL=https://console.4ndev.com/payment/success
ZOPAYO_ERROR_URL=https://console.4ndev.com/payment/error

# PostgreSQL backups
BACKUP_RETENTION_DAYS=7
# Optional off-site backup:
# BACKUP_REMOTE_TARGET=backupuser@backup-host
# BACKUP_REMOTE_DIR=/srv/4n-dev-core
