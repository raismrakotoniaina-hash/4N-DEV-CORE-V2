# Copy to /etc/4n-dev-core/core.env on the VPS.
# Never commit real credentials or place them in GitHub.
NODE_ENV=production
PORT=10000

# PostgreSQL on the same VPS. Replace the password placeholder locally.
DATABASE_URL=postgresql://fourndev_app:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/fourndev_core
DB_SSL=false

# Required after a real domain is purchased and DNS/HTTPS are prepared.
CORE_DOMAIN=
CORS_ORIGIN=

# Generate unique random values locally; never use example values in production.
API_KEY_PEPPER=
SESSION_SECRET=

# Keep disabled until provider credentials and pricing are verified.
AI_PROVIDER=none
OPENAI_API_KEY=

# Optional: leave all four empty until Zopayo is configured.
ZOPAYO_API_KEY=
ZOPAYO_WEBHOOK_SECRET=
ZOPAYO_SUCCESS_URL=
ZOPAYO_ERROR_URL=
